# ============================================================
# IntelliCourse AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── AI / LLM ──────────────────────────────────────────────
# Leave empty to run in MOCK_MODE (no API calls, sample data only)
OPENAI_API_KEY=

# Model for chat completions (gpt-4o, gpt-4.1, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o

# Embedding model (text-embedding-3-large or text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-large

# ── Vector Database (ChromaDB) ─────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=courses

# ── Cache (Redis) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ── SQL Database (PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intellicourse

# ── Application ────────────────────────────────────────────
TOP_K_RESULTS=10
RERANK_TOP_K=5
MAX_TOKENS=2000

# Allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Path to course CSV/JSON dataset (relative to backend/ directory)
COURSES_DATA_PATH=data/courses.csv

# ── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
